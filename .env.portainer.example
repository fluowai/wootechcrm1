# =============================================================================
# WooTech CRM - Variaveis para Portainer Stack
# Dominio: crm.wootech.com.br
# =============================================================================
#
# COMO USAR:
# 1. Copie este arquivo para referenciar as variaveis necessarias.
# 2. No Portainer > Stacks > Nova Stack > cole o docker-stack.portainer.yml.
# 3. Na aba "Environment Variables", adicione TODAS as variaveis abaixo
#    com os valores reais.
# 4. IMPORTANTE: Nao cole o .env inteiro — o Portainer usa pares chave=valor.
#
# ARQUITETURA:
#   crm.wootech.com.br (HTTPS via Traefik)
#        |
#        +--> [Traefik] --> frontend (nginx:80)
#        +--> [Traefik] --> api (node:10000)      /api, /lp, /socket.io
#        |
#        +--> redis (6379)
#        +--> google-maps-scraper (8080)
#        +--> whatsapp-bridge (8091)
#        +--> litellm (4000)
#        +--> worker (background jobs)
# =============================================================================

# ==========================================================================
# 1. DATABASE (OBRIGATORIO)
# ==========================================================================
DATABASE_URL=postgresql://postgres.SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&statement_cache_size=0
DIRECT_URL=postgresql://postgres.SENHA@db.PROJETO.supabase.co:5432/postgres?sslmode=require&schema=public

# ==========================================================================
# 2. AUTH (OBRIGATORIO)
# ==========================================================================
JWT_SECRET=MINHA_CHAVE_ALEATORIA_64_CHARS_MINIMO_troque_isto_aqui_3232

# ==========================================================================
# 3. SUPABASE (OBRIGATORIO)
# ==========================================================================
SUPABASE_URL=https://MEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================================================
# 4. URLS / DOMINIO
# ==========================================================================
FRONTEND_URL=https://crm.wootech.com.br
CORS_ORIGINS=https://crm.wootech.com.br,https://www.crm.wootech.com.br

# ==========================================================================
# 5. WHITELABEL (Personalizacao de dominio por tenant)
# ==========================================================================
# IP do servidor para registros A (deixe vazio se nao usar white-label)
WHITELABEL_DOCKER_IP=
WHITELABEL_CNAME_TARGET=crm.wootech.com.br

# ==========================================================================
# 6. WHATSAPP BRIDGE (OBRIGATORIO)
# ==========================================================================
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:8091
WHATSAPP_BRIDGE_PUBLIC_URL=https://crm.wootech.com.br
WHATSAPP_BRIDGE_SECRET=GERA_UM_SEGREDO_ALEATORIO_LONGO_AQUI_PARA_O_BRIDGE
NEXUS_BACKEND_URL=http://api:10000

# ==========================================================================
# 7. GOOGLE MAPS SCRAPER
# ==========================================================================
GOOGLE_MAPS_SCRAPER_CONCURRENCY=2
GOOGLE_MAPS_SCRAPER_WORKERS=2
GOOGLE_MAPS_SCRAPER_BROWSER_POOL=1
GOOGLE_MAPS_SCRAPER_JOB_TIMEOUT_MS=240000

# ==========================================================================
# 8. FRONTEND BUILD (Variaveis VITE — embutidas no build do frontend)
# ==========================================================================
# Em producao "same-origin" faz o frontend chamar a propria origem
VITE_API_URL=same-origin
VITE_LIVEKIT_URL=
VITE_PANEL_URL=https://crm.wootech.com.br

# ==========================================================================
# 9. AI / LITELLM (Opcional — pelo menos uma chave AI necessaria)
# ==========================================================================
AI_CORE_URL=http://litellm:4000/v1
AI_CORE_API_KEY=
AI_CORE_DEFAULT_MODEL=gpt-4o-mini
LITELLM_MASTER_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
CHATGPT_API_KEY=
TOGETHER_API_KEY=

# ==========================================================================
# 10. SEARCH / SCRAPING APIs (Opcional)
# ==========================================================================
SERPER_API_KEY=
SERPAPI_API_KEY=
SERP_API_KEY=
OUTSCRAPER_API_KEY=
OUTSCRAPER_KEY=
MUAC_API_KEY=

# ==========================================================================
# 11. LIVEKIT (Opcional — video/audio calls)
# ==========================================================================
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ==========================================================================
# 12. BILLING (Opcional)
# ==========================================================================
BILLING_WEBHOOK_SECRET=
ASAAS_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# ==========================================================================
# 13. MINIO / STORAGE (Opcional)
# ==========================================================================
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=
MINIO_REGION=us-east-1

# ==========================================================================
# 14. CNPJ (Opcional)
# ==========================================================================
CNPJ_WEBDAV_TOKEN=

# ==========================================================================
# NOTAS
# ==========================================================================
# - A rede woopanel1 DEVE existir no Docker Swarm (onde o Traefik roda).
# - O Traefik precisa ter o certresolver "letsencryptresolver" configurado.
# - As imagens sao pulladas do GHCR: ghcr.io/fluowai/wootech-crm-*
# - O container do API monta /var/run/docker.sock como read-only.
# - Em producao, o SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD nao sao usados
#   via stack (o seed ja foi executado ou sera manual via prisma seed).
